# Example stack config (copy values into a local Pulumi.prod.yaml via `pulumi config`).
# Never commit real tokens. CI sets these from GitHub Actions secrets.

config:
  edge-dns-archlens-dev:accountId: "<cloudflare-account-id>"
  edge-dns-archlens-dev:zoneName: archlens.dev
  # Requires Zone Settings Read/Write on the API token:
  # edge-dns-archlens-dev:manageSettings: "true"
  # edge-dns-archlens-dev:ssl: full
  # edge-dns-archlens-dev:alwaysUseHttps: "on"
  # edge-dns-archlens-dev:minTlsVersion: "1.2"
  # edge-dns-archlens-dev:automaticHttpsRewrites: "on"
  # edge-dns-archlens-dev:tls13: "on"
  # cloudflare:apiToken:
  #   secure: <set via: pulumi config set --secret cloudflare:apiToken>
