# Stacks are named after the zone (e.g. archlens.dev).
# accountId and optional manageSettings live in zones.yaml.
# CLOUDFLARE_API_TOKEN comes from the environment, not from stack config.
#
#   export CLOUDFLARE_API_TOKEN=…
#   export PULUMI_ACCESS_TOKEN=…
#   pulumi stack init archlens.dev
#   pulumi preview
#
# Optional overrides (defaults live in index.ts; manageSettings must be true
# in zones.yaml before TLS settings apply):
#   pulumi config set ssl full
#   pulumi config set alwaysUseHttps on
#   pulumi config set minTlsVersion 1.2
#   pulumi config set automaticHttpsRewrites on
#   pulumi config set tls13 on
#
# Optional org vanity redirect (usually set via zones.yaml role: vanity instead):
#   pulumi config set canonicalRedirectTo mzworthington.co.uk
