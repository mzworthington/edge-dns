# Shell values for `setup-cloudflare-hosting`. Secrets are not stored here.
# They come from the Bitwarden Secrets Manager project:
#   CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_ZONE_ID, PULUMI_ACCESS_TOKEN
#
#   export BWS_ACCESS_TOKEN=... BWS_PROJECT_ID=...
#   export PULUMI_STACK=prod DOMAIN=example.com
#   setup-cloudflare-hosting
#
# Pages project and hostnames: infra/cloudflare/hosting.yaml

PULUMI_STACK=prod
DOMAIN=example.com
