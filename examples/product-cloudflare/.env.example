# Local hosting bootstrap: copy to `.env` and fill in. Never commit `.env`.
# Used by `bin/setup-cloudflare-hosting.sh` (auto-sourced when present).
# CI uses GitHub Actions secrets/vars instead.

PULUMI_STACK=prod

# Existing active Cloudflare zone name (created/managed in edge-dns)
DOMAIN=example.com

# Comma-separated hostnames to attach to the Pages project
PAGES_HOSTNAMES=app.example.com

# Pages project name (also used for *.pages.dev)
PAGES_PROJECT_NAME=my-app

# Required for API calls (or provide via Bitwarden Secrets Manager)
# CLOUDFLARE_API_TOKEN=

# Optional: script can resolve these from the API token
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=

# Optional: script can mint one after `pulumi login`
# PULUMI_ACCESS_TOKEN=

# Optional Bitwarden Secrets Manager
# BWS_ACCESS_TOKEN=
# BWS_PROJECT_ID=

# Optional legacy apex+www shape (sets Pulumi apexDomain/wwwDomain + GH vars)
# WWW_DOMAIN=www.example.com

# Optional R2 catalog (ArchLens-style)
# CATALOG_BUCKET_NAME=my-catalog
# CATALOG_DOMAIN=catalog.example.com
